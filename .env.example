# Docker Compose maps 127.0.0.1:${TABLON_HOST_PORT} to container port 8080.
# To expose Tablon on a LAN, edit docker-compose.yml to bind 0.0.0.0 and set a
# token and HTTPS. Do not change this value to an address.
TABLON_HOST_PORT=8080

# Optional bearer token. Leave empty only for loopback-only use.
# When set, all /api/v1 requests require "Authorization: Bearer <token>".
TABLON_API_TOKEN=

TABLON_IDLE_ENABLED=true
TABLON_IDLE_TIMEOUT=5m
TABLON_LOG_LEVEL=info

# Optional metadata for local image builds. Releases set these automatically.
TABLON_VERSION=dev
TABLON_COMMIT=unknown
TABLON_BUILD_DATE=unknown

# Native binary examples (not used by Docker Compose):
# TABLON_HOST=127.0.0.1
# TABLON_PORT=8080
# TABLON_DATA_DIR=./data
